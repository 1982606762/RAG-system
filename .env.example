# Copy only for a NEW installation. Merge these values into an existing .env.
# Keep the existing database password when reusing an existing pgdata volume.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Run: docker compose run --rm --no-deps app python cli.py hash-password
# Paste its complete output here. Keep the single quotes around the bcrypt hash:
# they prevent Docker Compose from interpreting its dollar signs.
OWNER_PASSWORD_HASH=''

# Session lifetime, in minutes. Restart the API after changing configuration.
JWT_EXPIRE_MINUTES=1440

# Local OCR languages. Docker includes all three language packs.
OCR_LANGUAGES=eng+dan+chi_sim

# Set this to use Google Document AI Layout Parser for OCR.
# GOOGLE_DOCUMENT_AI_PROCESSOR=projects/724252786642/locations/eu/processors/827f858573988453

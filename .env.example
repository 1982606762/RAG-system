# Copy this file to ".env" and fill in your key.
# docker compose automatically reads .env in the same folder.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# PostgreSQL password. Generate a strong one with:
#   openssl rand -hex 24
# REQUIRED: docker compose will refuse to start without it.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Secret that signs login (JWT) tokens. Generate one with:
#   openssl rand -hex 32
# REQUIRED in production — without it, login tokens can be forged.
JWT_SECRET=change-me-to-a-long-random-string

# Maximum accepted upload size in bytes (default: 50 MiB).
# MAX_UPLOAD_BYTES=52428800

# Open self-registration. Keep this FALSE for a private knowledge base: anyone
# who finds your public URL could otherwise sign up and spend your Claude quota.
# Create accounts via:  docker compose exec app python cli.py create-user <email>
ALLOW_REGISTER=false

# Redis URL for Celery (broker + result backend). The docker-compose default
# already points at the "redis" service, so you only need to set this when
# running outside compose.
# REDIS_URL=redis://redis:6379/0
